# Secrets defined here are available for reference under registry/password, env/secret, builder/secrets,
# and accessories/*/env/secret in config/deploy.yml. All secrets should be pulled from either
# password manager, ENV, or a file. DO NOT ENTER RAW CREDENTIALS HERE! This file needs to be safe for git.

# Use the local credential file if present (workstation deploys); otherwise fall
# back to the environment variable, which CI sets from GitHub Actions secrets.
# dotenv does NOT support ${VAR:-default}, so we branch with a shell || inside
# $(...). The CI env value is used verbatim, so the GitHub secret must NOT have a
# trailing newline (set it with: printf %s 'TOKEN' | gh secret set NAME).
KAMAL_REGISTRY_PASSWORD=$(cat config/credentials/dockerhub.key 2>/dev/null || printf %s "$KAMAL_REGISTRY_PASSWORD")
RAILS_MASTER_KEY=$(cat config/credentials/production.key 2>/dev/null || printf %s "$RAILS_MASTER_KEY")

