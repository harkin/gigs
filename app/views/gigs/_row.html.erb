<%
  url = event_link(event)
  tag = url ? "a" : "div"
  multi_day = event.multi_day?
  time = display_time(event)
  sold = event.sold_out?
  label = status_label(event.ticket_status)
  venue = event.renderable_venue
  venue_text = multi_day ? "#{venue} · until #{event.end_date.strftime("%-d %b")}" : venue
  new_gig = event.newly_announced?
%>
<<%= tag %><% if url %> href="<%= url %>"<% end %> class="row<%= " is-sold" if sold %>" data-listing-target="row" data-start="<%= event.event_date.to_date.iso8601 %>" data-end="<%= (event.end_date || event.event_date).to_date.iso8601 %>" data-search="<%= "#{event.title} #{venue}".downcase %>" data-venue="<%= event.venue %>" data-new="<%= new_gig %>" data-sold="<%= sold %>">
  <span class="time<%= " tbc" unless time || multi_day %>"><%= time || ("—" unless multi_day) %></span>
  <span class="title"><%= event.title %><% if new_gig %><span class="new">New</span><% end %></span>
  <span class="venue-d"><%= venue_text %></span>
  <span class="status-d"><% if label %><span class="status <%= event.ticket_status %>"><%= label %></span><% end %></span>
  <span class="price"><%= event.price %></span>
  <span class="go" aria-hidden="true"><% if url %><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 6 6 6-6 6"/></svg><% end %></span>
  <span class="sub">
    <span><%= venue_text %></span>
    <% if label %><span class="status <%= event.ticket_status %>"><%= label %></span><% end %>
  </span>
</<%= tag %>>
