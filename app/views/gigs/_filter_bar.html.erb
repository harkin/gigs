<div class="sticky top-0 z-10 filter-bar -mx-4 px-4 py-4 mb-6">
  <div class="flex flex-wrap gap-3 items-center">
    <div class="flex-1 min-w-[200px]">
      <input type="text"
             placeholder="Search events..."
             data-filter-target="search"
             data-action="input->filter#filter"
             class="filter-input w-full shadow-sm text-sm px-3 py-2">
    </div>

    <div class="relative">
      <button type="button"
              data-filter-target="venueButton"
              data-action="click->filter#toggleVenueMenu"
              aria-haspopup="true"
              aria-expanded="false"
              class="venue-button filter-input shadow-sm text-sm px-3 py-2 flex items-center gap-2">
        <span data-filter-target="venueLabel" class="venue-button-label">All Venues</span>
        <span aria-hidden="true" style="opacity: 0.6; font-size: 0.7em;">▼</span>
      </button>

      <div data-filter-target="venueMenu"
           role="group"
           aria-label="Filter by venue"
           class="venue-menu hidden">
        <div class="venue-menu-header">
          <span>Venues</span>
          <button type="button"
                  data-action="click->filter#clearVenues"
                  style="text-decoration: underline;">Clear</button>
        </div>
        <% @venues.each do |name, value| %>
          <label class="venue-option">
            <input type="checkbox"
                   value="<%= value %>"
                   data-filter-target="venueCheckbox"
                   data-action="change->filter#filter">
            <span><%= name %></span>
          </label>
        <% end %>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <input type="date"
             data-filter-target="dateFrom"
             data-action="change->filter#filter"
             class="filter-input filter-date shadow-sm text-sm px-3 py-2"
             title="From date">
      <span style="color: var(--text-muted); font-size: 0.875rem;">to</span>
      <input type="date"
             data-filter-target="dateTo"
             data-action="change->filter#filter"
             class="filter-input filter-date shadow-sm text-sm px-3 py-2"
             title="To date">
    </div>

    <button type="button"
            data-action="click->filter#reset"
            style="color: var(--text-muted); font-size: 0.875rem; text-decoration: underline;">
      Reset
    </button>
  </div>
</div>
